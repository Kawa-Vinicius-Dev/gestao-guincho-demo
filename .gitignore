# Ambiente local
.env
.env.*
!.env.example
# A bancada visual (npm run bancada) roda sem rede: a URL e a chave abaixo sao
# de mentira e existem so para o cliente do Supabase subir. Sem segredo, e
# versionada para qualquer um conseguir abrir as telas sem configurar nada.
!frontend/.env.bancada
.env.local
backend/data/
# Arquivos importados que ficaram no disco de quem rodou o sistema antes de
# tudo migrar para o Supabase Storage. Nao sao mais gravados, mas continuam
# existindo em maquina de desenvolvimento - e sao PDFs reais da operacao.
storage/
backend/storage/
playwright-report/
test-results/
frontend/test-results/

# Logs
*.log

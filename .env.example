DATABASE_URL=jdbc:postgresql://localhost:5432/fluxo_gestao
DATABASE_USERNAME=fluxo
DATABASE_PASSWORD=fluxo
CORS_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@fluxogestao.local
ADMIN_PASSWORD=troque-esta-senha
SESSION_HOURS=12

# Comprovantes de despesa e arquivos de importacao (Porto e PDF legado): armazenados no Supabase
# Storage (bucket privado, prefixos diferentes por origem), nao em disco local.
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=comprovantes

# Frontend: pode ficar vazio no ambiente local.
# No Vercel, configure como a URL pública do backend no Render (ex.: https://SEU-SERVICO.onrender.com/api)
VITE_API_URL=

# ---------------------------------------------------------------------------
# Migracao para o Supabase
# ---------------------------------------------------------------------------
# A chave anon e publica por natureza: ela nao concede nada sozinha, quem decide
# o que cada pessoa alcanca sao as policies do banco. A service_role NUNCA entra
# aqui — tudo que comeca com VITE_ vai para o bundle que qualquer visitante baixa.
# O cliente recusa subir se detectar uma chave de servico nesta variavel, porque
# com ela tudo funcionaria (ela ignora RLS) e por isso ninguem notaria o erro.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Quais modulos ja falam direto com o Supabase, separados por virgula. Vazio
# mantem tudo no backend antigo; `tudo` liga todos. Rollback e tirar um nome
# daqui e republicar.
#
#   Disponiveis: auth, veiculos, motoristas, categorias, contratantes,
#                despesas, receitas, dashboard, comissoes
#
# `despesas` cobre tambem o comprovante, que passa a ir direto do navegador para
# o Storage — o backend deixa de intermediar o upload.
#
# `dashboard` cobre os indicadores, o extrato e as contas a receber — as tres
# coisas saem das mesmas agregacoes e nao fazem sentido separadas.
#
# `auth` e pre-requisito dos demais: as policies identificam quem chama pelo JWT
# do Supabase, e sem essa sessao qualquer consulta direta chega como visitante.
VITE_SUPABASE_MODULOS=

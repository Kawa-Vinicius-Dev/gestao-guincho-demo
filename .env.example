DATABASE_URL=jdbc:postgresql://localhost:5432/fluxo_gestao
DATABASE_USERNAME=fluxo
DATABASE_PASSWORD=fluxo
CORS_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@fluxogestao.local
ADMIN_PASSWORD=troque-esta-senha
SESSION_HOURS=12

# Comprovantes de despesa e arquivos de importacao (Porto e PDF legado): armazenados no Supabase
# Storage (bucket privado, prefixos diferentes por origem), nao em disco local.
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=comprovantes

# Frontend: pode ficar vazio no ambiente local.
# No Vercel, configure como a URL pública do backend no Render (ex.: https://SEU-SERVICO.onrender.com/api)
VITE_API_URL=

DATABASE_URL=jdbc:postgresql://localhost:5432/fluxo_gestao
DATABASE_USERNAME=fluxo
DATABASE_PASSWORD=fluxo
CORS_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@fluxogestao.local
ADMIN_PASSWORD=troque-esta-senha
SESSION_HOURS=12

# Comprovantes de despesa e arquivos de importacao (Porto e PDF legado): armazenados no Supabase
# Storage (bucket privado, prefixos diferentes por origem), nao em disco local.
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=comprovantes

# ---------------------------------------------------------------------------
# Frontend (Vercel): fala direto com o Supabase
# ---------------------------------------------------------------------------
# A chave anon e publica por natureza: ela nao concede nada sozinha, quem decide
# o que cada pessoa alcanca sao as policies do banco. A service_role NUNCA entra
# aqui — tudo que comeca com VITE_ vai para o bundle que qualquer visitante baixa.
# O cliente recusa subir se detectar uma chave de servico nesta variavel, porque
# com ela tudo funcionaria (ela ignora RLS) e por isso ninguem notaria o erro.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

